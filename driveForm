<form id="driveForm">
  <input type="text" id="fullName" placeholder="نام و نام خانوادگی" required>
  <input type="text" id="nationalCode" placeholder="کد ملی" required>
  <input type="tel" id="phone" placeholder="شماره تماس" required>
  <textarea id="description" placeholder="توضیحات پرونده"></textarea>
  <label>پیوست مدرک (عکس یا PDF):</label>
  <input type="file" id="applicantFile">
  <button type="submit" id="submitBtn">ثبت در گوگل درایو</button>
</form>

<p id="status"></p>

<script>
const DRIVE_API_URL = 'لینک_WEB_APP_URL_خود_را_اینجا_قرار_دهید';

// تابع تبدیل فایل به Base64 برای ارسال به گوگل درایو
function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => resolve(reader.result.split(',')[1]);
    reader.onerror = error => reject(error);
  });
}

// ۱. ارسال اطلاعات و فایل به گوگل درایو
document.getElementById('driveForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const status = document.getElementById('status');
  const btn = document.getElementById('submitBtn');
  
  btn.disabled = true;
  status.innerText = 'در حال ایجاد پرونده در گوگل درایو...';

  const fileInput = document.getElementById('applicantFile');
  let fileData = null, fileName = null, fileType = null;

  if (fileInput.files.length > 0) {
    const file = fileInput.files[0];
    fileName = file.name;
    fileType = file.type;
    fileData = await fileToBase64(file);
  }

  const payload = {
    fullName: document.getElementById('fullName').value,
    nationalCode: document.getElementById('nationalCode').value,
    phone: document.getElementById('phone').value,
    description: document.getElementById('description').value,
    fileName: fileName,
    fileType: fileType,
    fileData: fileData
  };

  try {
    const response = await fetch(DRIVE_API_URL, {
      method: 'POST',
      body: JSON.stringify(payload)
    });
    const result = await response.json();
    
    if (result.status === 'success') {
      status.innerText = 'پرونده با موفقیت در گوگل درایو ذخیره شد!';
      document.getElementById('driveForm').reset();
    } else {
      status.innerText = 'خطا در ثبت: ' + result.message;
    }
  } catch (error) {
    status.innerText = 'ارتباط با گوگل درایو برقرار نشد.';
  } finally {
    btn.disabled = false;
  }
});

// ۲. تابع دریافت لیست تمام متقاضیان از گوگل درایو (برای نمایش در جدول اتوماسیون)
async function loadApplicantsFromDrive() {
  const response = await fetch(DRIVE_API_URL);
  const applicants = await response.json();
  console.log('لیست متقاضیان ذخیره‌شده در درایو:', applicants);
  return applicants;
}
</script>
