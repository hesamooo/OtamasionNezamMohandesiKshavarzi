<form id="driveForm">
  <input type="text" id="fullName" placeholder="نام و نام خانوادگی" required>
  <input type="text" id="nationalCode" placeholder="کد ملی" required>
  <input type="tel" id="phone" placeholder="شماره تماس" required>
  <textarea id="description" placeholder="توضیحات کامل پرونده"></textarea>
  <label>پیوست مدرک (عکس یا PDF):</label>
  <input type="file" id="applicantFile">
  <button type="submit" id="submitBtn">ثبت در گوگل درایو</button>
  <button type="button" id="reloadBtn" onclick="loadApplicantsFromDrive()">بازخوانی از گوگل درایو</button>
</form>

<p id="status"></p>
<div id="driveApplicantsList"></div>

<script>
const DRIVE_API_URL = 'https://script.google.com/macros/s/AKfycbyd7lrIZfKVUm09OzBQewj8_XRWJfMpd8vCm6DV-tAUXEkA33LgqL10UKe8Yz17TwM2/exec';

function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => resolve(reader.result.split(',')[1]);
    reader.onerror = error => reject(error);
  });
}

// ۱. ارسال کامل اطلاعات و فایل به گوگل درایو (بدون خطای CORS)
document.getElementById('driveForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const status = document.getElementById('status');
  const btn = document.getElementById('submitBtn');

  btn.disabled = true;
  status.innerText = '⏳ در حال ذخیره پرونده در گوگل درایو...';

  const fileInput = document.getElementById('applicantFile');
  let fileData = null, fileName = null, fileType = null;

  if (fileInput && fileInput.files.length > 0) {
    const file = fileInput.files[0];
    fileName = file.name;
    fileType = file.type;
    fileData = await fileToBase64(file);
  }

  const payload = {
    action: 'saveApplicant',
    fullName: document.getElementById('fullName').value.trim(),
    nationalCode: document.getElementById('nationalCode').value.trim(),
    phone: document.getElementById('phone').value.trim(),
    description: document.getElementById('description').value.trim(),
    fileName: fileName,
    fileType: fileType,
    fileData: fileData,
    updatedAt: Date.now()
  };

  try {
    const response = await fetch(DRIVE_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
      redirect: 'follow'
    });
    const result = await response.json();

    if (result.status === 'success') {
      status.innerText = '✅ پرونده با موفقیت در گوگل درایو ذخیره شد!';
      document.getElementById('driveForm').reset();
      await loadApplicantsFromDrive();
    } else {
      status.innerText = '⚠️ خطا در ثبت: ' + (result.message || 'خطای نامشخص');
    }
  } catch (error) {
    status.innerText = '❌ ارتباط با گوگل درایو برقرار نشد.';
  } finally {
    btn.disabled = false;
  }
});

// ۲. بازخوانی تمام اطلاعات ذخیره‌شده از گوگل درایو در هر مرورگر یا دستگاه جدید
async function loadApplicantsFromDrive() {
  const status = document.getElementById('status');
  const listBox = document.getElementById('driveApplicantsList');
  try {
    if (status) status.innerText = '🔄 در حال بازخوانی اطلاعات از گوگل درایو...';
    const url = DRIVE_API_URL + (DRIVE_API_URL.includes('?') ? '&' : '?') + 't=' + Date.now();
    const response = await fetch(url, { method: 'GET', redirect: 'follow' });
    const data = await response.json();

    const items = Array.isArray(data) ? data : (data && data.data ? data.data : []);
    if (status) status.innerText = '✅ اطلاعات از گوگل درایو بازخوانی شد (' + items.length + ' رکورد).';

    if (listBox && Array.isArray(items)) {
      listBox.innerHTML = items
        .filter(x => x && (x.fullName || x._type === 'FULL_STORAGE_SYNC'))
        .map(x => {
          if (x._type === 'FULL_STORAGE_SYNC') {
            return '<div>📦 <b>پشتیبان کامل سامانه ۶۳۶</b> — آخرین بروزرسانی: ' + (x.updatedAtFa || '') + '</div>';
          }
          return '<div>👤 <b>' + (x.fullName || '') + '</b> | کدملی: ' + (x.nationalCode || '') + ' | تلفن: ' + (x.phone || '') + '</div>';
        }).join('<hr>');
    }
    return items;
  } catch (err) {
    if (status) status.innerText = '❌ خطا در بازخوانی اطلاعات از گوگل درایو.';
    return [];
  }
}

document.addEventListener('DOMContentLoaded', loadApplicantsFromDrive);
</script>
